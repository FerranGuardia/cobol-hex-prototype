# Copy to .env and adjust. All vars are overridable by CLI flags.

# Absolute path to the COBOL source corpus root.
# Default symlink: corpus/CardDemo -> ../CardDemo
COBOL_CORPUS=./corpus/CardDemo

# Codex CLI binary (installed system-wide; we shell out to it).
CODEX_BIN=codex

# Model passed to Codex. Codex picks a default if unset.
LLM_MODEL=gpt-5-codex

# Sampling controls. Keep temperature=0 for determinism unless adversarial-testing.
LLM_TEMPERATURE=0
LLM_SEED=42

# Cache + artifacts.
CACHE_DIR=.cache
ARTIFACTS_DIR=artifacts

# Per-call budget (in seconds). Hard wall-clock cap.
LLM_TIMEOUT_SECONDS=600

# Logging
LOG_LEVEL=INFO
