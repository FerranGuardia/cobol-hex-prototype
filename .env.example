# Copy to .env and adjust. All vars are overridable by CLI flags.

# Absolute path to the COBOL source corpus root.
# Default symlink: corpus/CardDemo -> ../CardDemo
COBOL_CORPUS=./corpus/CardDemo

# Codex CLI binary. Use the absolute path if it isn't on PATH.
# - Standalone install (brew/npm): `codex` is enough
# - Desktop app on macOS: /Applications/Codex.app/Contents/Resources/codex
# - VS Code ChatGPT extension bundle (varies by version):
#     ~/.vscode/extensions/openai.chatgpt-*/bin/macos-aarch64/codex
CODEX_BIN=codex

# Model passed to Codex.
# - On a ChatGPT/Codex subscription: gpt-5.5 (or leave empty to use Codex's default)
# - On an OpenAI API key: gpt-5-codex (a Codex-tuned variant) works
# Leave empty (LLM_MODEL=) to let Codex pick its account-appropriate default.
LLM_MODEL=gpt-5.5

# Sampling controls. Keep temperature=0 for determinism unless adversarial-testing.
LLM_TEMPERATURE=0
LLM_SEED=42

# Cache + artifacts.
CACHE_DIR=.cache
ARTIFACTS_DIR=artifacts

# Per-call budget (in seconds). Hard wall-clock cap.
LLM_TIMEOUT_SECONDS=600

# Logging
LOG_LEVEL=INFO
